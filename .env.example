# 服务端口
PORT=3000

# JWT 密钥(生产环境务必修改)
JWT_SECRET=change-me-to-a-long-random-string

# MySQL 连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=chatroom

# Microsoft Graph / OneDrive 企业版(客户端凭据流)
# 见 README「OneDrive 接入」章节:在 Azure 门户注册应用并授权
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# 要使用的 OneDrive 驱动器 ID(通常为 "b!..." 格式)
GRAPH_DRIVE_ID=
# 上传根目录(自动创建)
GRAPH_FILES_ROOT=chatroom-files

# Web Push VAPID 密钥(运行 `npm --prefix server run gen:vapid` 生成)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 允许的前端来源(CORS,逗号分隔;同源反代部署下实际不触发)
CLIENT_ORIGIN=https://chatroom.20081127.xyz,http://test.20081127.xyz,http://localhost:5173
